# EduGuide PH local environment template
# Copy this file to .env.local and fill in the real values.
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://ucbvsvpzvdsyhorriefc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Server-only Gemini credential. Do NOT prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=AQ.your_gemini_key_here

# Optional model override. EduGuide defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash


# Transactional email for school-admin teacher verification notifications.
# Create this in your email provider and keep it server-side.
RESEND_API_KEY=re_your_resend_api_key_here

# Optional sender override. Verify your own domain before production use.
EDUGUIDE_EMAIL_FROM=EduGuide PH <onboarding@resend.dev>
